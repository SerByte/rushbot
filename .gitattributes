# Normalize line endings across Windows/Linux/macOS
* text=auto

# Sources + docs: LF in the repo, native checkout
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Batch files must stay CRLF to execute on Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
